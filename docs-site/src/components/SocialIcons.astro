---
// Custom header links - text instead of icons
---

<div class="header-links">
  <a href="https://guardbot.sbs" class="header-link">Homepage</a>
  <a href="https://guardbot.sbs/user/support" class="header-link">Support</a>
</div>

<style>
  .header-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .header-link {
    color: var(--sl-color-text);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    transition: color 0.2s, background 0.2s;
  }

  .header-link:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-accent);
  }
</style>
