# Copy to deploy.env and fill in. deploy.env is gitignored -- it holds the
# address of your production box, so it does not belong in the repo.
#
#   cp deploy.env.example deploy.env

# --- Server ------------------------------------------------------------------

# Hostname or IP of the VPS.
SSH_HOST=

# User to connect as. Deploying as root avoids needing sudo on minimal images;
# any other user must be able to sudo without a password prompt.
SSH_USER=root
SSH_PORT=22

# Path to the private key. Leave blank to use your ssh-agent / default key.
SSH_KEY=

# --- Layout ------------------------------------------------------------------

APP_NAME=botginx
APP_DIR=/opt/botginx
CONFIG_DIR=/etc/botginx
SERVICE_NAME=botginx

# Unprivileged system user the service runs as. Created by --setup.
RUN_USER=botginx

# --- Networking --------------------------------------------------------------

# Port the app listens on locally. nginx proxies to this; it is not exposed.
APP_PORT=3001

# Domain for the admin panel, e.g. panel.example.com. Its DNS must already
# point at this server before TLS can be issued. Leave blank to skip nginx.
PANEL_DOMAIN=

# Email for Let's Encrypt expiry notices. Leave blank to skip certbot and set
# TLS up by hand later.
CERTBOT_EMAIL=

# --- Antibot Integration -----------------------------------------------------

# Set to true when botection is installed on the same server.
# Traffic: nginx → :8080 (botection) → :3001 (botginx)
ANTIBOT_MODE=true
ANTIBOT_PORT=8080

# --- Database ----------------------------------------------------------------

# PostgreSQL credentials. --setup creates these on the server.
# DB_PASS is auto-generated if not set.
DB_NAME=botginx
DB_USER=botginx
DB_PASS=

# --- Build -------------------------------------------------------------------

# Change BUILD_ARCH to arm64 for Ampere, Graviton, or an ARM VPS.
BUILD_OS=linux
BUILD_ARCH=amd64
